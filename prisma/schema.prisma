// KPI Tracker schema.
// Local dev uses SQLite (zero setup). For production on Supabase, change
// provider to "postgresql" and point DATABASE_URL at Supabase — the models
// below are written to be portable (no SQLite-only features; enums are stored
// as validated strings so the schema moves cleanly to Postgres).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A person who enters KPIs (rep) or receives alerts (manager/admin).
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("rep") // rep | manager | admin  (permission level)
  position  String   @default("") // acquisitions | cc_lm | dispositions  (which scorecard)
  note      String   @default("") // free-text context, e.g. "part-time, CA listings"
  irregularSchedule Boolean @default(false) // exempt from missing-entry alerts (no set schedule)
  tracksInternet    Boolean @default(true) // logs daily internet speed + gets low-speed nags (whole team)
  active    Boolean  @default(true)
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())

  entries Entry[]
  targets Target[]
  alerts  Alert[]
  pips    Pip[]
  tickets Ticket[]
  timeOff TimeOff[]
  punches Punch[]
}

// The catalog of measurables (the spreadsheet's "Measurable" rows).
model Kpi {
  id         String  @id @default(cuid())
  key        String  @unique // stable slug, e.g. "outbound_calls"
  name       String
  emoji      String  @default("")
  category   String // green | blue | yellow | red  (drives alert severity)
  unit       String // count | duration | percent | currency | ratio
  scope      String // per_rep | team
  roleKey    String  @default("") // acquisitions | cc_lm | dispositions ("" = any/team)
  cadence    String // daily | monthly
  goalValue  Float? // null when goalKind = tracked/computed
  goalKind   String  @default("at_least") // at_least | at_most | exact | tracked
  computed   Boolean @default(false) // true = derived (not entered by hand)
  formula    String? // identifier resolved in code for computed metrics
  definition String  @default("")
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  entries Entry[]
  targets Target[]
  alerts  Alert[]
}

// Optional per-rep or per-period goal override. No row = use Kpi.goalValue.
model Target {
  id        String  @id @default(cuid())
  kpi       Kpi     @relation(fields: [kpiId], references: [id])
  kpiId     String
  user      User?   @relation(fields: [userId], references: [id])
  userId    String? // null = team-wide override
  period    String? // "YYYY-MM" or null = standing override
  goalValue Float

  @@unique([kpiId, userId, period])
}

// The actual numbers entered. Duration values are stored in SECONDS;
// percent as the number (100 = 100%); currency as a plain number.
model Entry {
  id        String   @id @default(cuid())
  kpi       Kpi      @relation(fields: [kpiId], references: [id])
  kpiId     String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String? // null for team-scope KPIs
  date      String // "YYYY-MM-DD" in org timezone
  value     Float
  note      String   @default("")
  enteredBy String   @default("")
  enteredAt DateTime @default(now())

  @@unique([kpiId, userId, date])
  @@index([date])
}

// Every flag the alert engine raises.
model Alert {
  id           String   @id @default(cuid())
  kpi          Kpi      @relation(fields: [kpiId], references: [id])
  kpiId        String
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?
  date         String // "YYYY-MM-DD"
  severity     String // hard | soft
  expected     Float
  actual       Float
  message      String
  status       String   @default("open") // open | ack | resolved
  channelsSent String   @default("[]") // JSON array of channels delivered
  createdAt    DateTime @default(now())

  // Rep's own context, added from their entry screen before a manager reviews.
  repReason String?

  // Manager's resolution: why it was missed + what we'll do about it. Captured
  // when the alert is resolved so every closed alert is a documented decision.
  resolutionCategory String? // tech | leads | training | effort | excused | process | recovered
  resolutionNote     String? // what actually happened
  correctiveAction   String? // the fix (pre-filled from gap coaching, editable)
  resolvedBy         String? // name of the manager/rep who resolved it
  resolvedAt         DateTime?
  excused            Boolean   @default(false) // a legitimate non-miss (PTO, outage); excluded from PIP streaks + trends

  @@unique([kpiId, userId, date, severity]) // dedup: one per kpi/user/day/severity
  @@index([status])
}

// Performance Improvement Plan — a documented, progressive accountability track
// for a rep who keeps missing a key KPI. Stages: watch -> coaching -> pip -> outcome.
model Pip {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  kpiKey    String // the KPI that's being missed (e.g. appts_set)
  kpiName   String  @default("")
  stage     String  @default("coaching") // coaching | pip | final | closed
  status    String  @default("open") // open | resolved | escalated
  reason    String  @default("") // what triggered it (e.g. "3 consecutive days below goal")
  goalNote  String  @default("") // the target they must hit (e.g. "3 appts/day for 5 days")
  plan      String  @default("") // gap-based training plan / steps
  support   String  @default("") // support offered (leads, internet fix, training)
  consequence String @default("") // current consequence on the ladder
  checkins  String  @default("[]") // JSON: [{date, note}]
  startDate String  @default("") // "YYYY-MM-DD"
  reviewDate String @default("") // when the plan is evaluated
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// A support ticket: the team reports something broken/confusing in the tracker.
// A ticket is a REPORT, not a command — submitting one only stores text. Nothing
// changes until an admin approves it, which is the gate that keeps the team from
// being able to alter the system just by filing tickets.
model Ticket {
  id          String   @id @default(cuid())
  submittedBy String // display name of whoever filed it
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  title       String
  body        String   @default("")
  area        String   @default("") // which screen: Entry, Dashboard, Alerts, Speed test, Login, Other
  severity    String   @default("normal") // blocking | normal | minor
  // new -> approved -> in_progress -> resolved  (or new -> declined)
  status      String   @default("new")
  adminNote   String   @default("") // triage note: why declined, or how it was resolved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// A closed/paid wholesale deal — the permanent profit ledger (from HUDs).
// Source of truth for deal profit + count in Trends. Owner-only data.
model ClosedDeal {
  id        String   @id @default(cuid())
  address   String
  city      String   @default("")
  state     String   @default("")
  closeDate String // YYYY-MM-DD
  year      Int
  month     Int
  dealType  String   @default("assignment") // assignment | jv | wholetail | double_close | subject_to
  profit    Float
  notes     String   @default("")

  // how the lead was generated + what it cost us to acquire the deal
  leadSource      String @default("") // ppl | cold_call | other
  acquisitionCost Float? // cost to source the lead (null = not yet provided)

  // verification + provenance
  closedBy String  @default("") // dispo rep who marked it closed
  dealId   String? // originating Deal.id (null for historical imports)
  hudData  Bytes? // the uploaded HUD statement (proof) — owner-only
  hudName  String  @default("")
  hudType  String  @default("") // mime type

  createdAt DateTime @default(now())

  @@unique([address, closeDate])
  @@index([year])
}

// A link in the private Operations hub (owner-only): SOPs, scripts, training,
// onboarding/offboarding, tools. Curated launcher, not a doc store.
model Resource {
  id          String   @id @default(cuid())
  title       String
  url         String
  category    String   @default("General")
  description String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([category])
}

// Long-horizon monthly history for year-over-year trends. Imported from the old
// Excel scorecards (2024–2025) and extended over time. Raw inputs only; ratios
// (net, cost/lead, conversion) are computed on read so they can't drift.
model MonthlyMetric {
  id     String @id @default(cuid())
  year   Int
  month  Int // 1-12
  metric String // dials | connects | leads | offers | contracts | sold_deals | expenses | revenue
  value  Float
  source String @default("import")

  @@unique([year, month, metric])
  @@index([year])
}

// An AI-scored acquisitions call. The transcript is graded against a coaching
// rubric (Anthropic API). repName/scoredBy are plain strings (no FK) to keep it
// simple. Created via the Call Scoring page.
model CallScore {
  id         String   @id @default(cuid())
  repName    String   @default("")
  callType   String   @default("") // which call type was scored (see lib/call-types)
  scoredBy   String   @default("")
  overall    Int      @default(0) // 0-100
  breakdown  String   @default("[]") // JSON [{area, score, note}]
  summary    String   @default("")
  transcript String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Private HR / payment record per team member. OWNER-ONLY (Jon). Holds PII +
// payment destinations (Wise) + tenure/promotion/pay — never exposed to the team.
model TeamProfile {
  id            String   @id @default(cuid())
  userId        String?  @unique // link to the app User
  name          String
  birthday      String   @default("") // YYYY-MM-DD
  phone         String   @default("")
  address       String   @default("")
  startDate     String   @default("") // joined (YYYY-MM-DD)
  lastPromotion String   @default("") // YYYY-MM-DD
  payScale      String   @default("") // rate / amount
  payPeriod     String   @default("") // monthly | biweekly | hourly | per-deal
  payMethod     String   @default("Wise") // Wise / TransferWise / …
  payDetails    String   @default("") // bank / Wise details (sensitive)
  about         String   @default("") // details about them
  performance   String   @default("") // promotion-readiness notes
  updatedAt     DateTime @updatedAt
}

// Weekly top-performer wins — one per role per week, for the gamified leaderboard.
model WeeklyAward {
  id        String   @id @default(cuid())
  weekStart String // YYYY-MM-DD (Monday of the won week)
  role      String // Acquisitions | Dispositions
  repName   String
  kpiName   String   @default("")
  value     String   @default("")
  createdAt DateTime @default(now())

  @@unique([weekStart, role])
}

// The approved script/process per call type — the AI scores adherence to it.
model CallScript {
  id        String   @id @default(cuid())
  callType  String   @unique
  script    String   @default("")
  updatedAt DateTime @updatedAt
}

// An AI-generated improvement recommendation for the tracker itself. Populated
// by the assistant (now) and a weekly analysis agent (later) via a secured API.
// Jon/Marie review on the "AI Updates" tab and accept or decline each — nothing
// is ever auto-applied.
model Suggestion {
  id        String   @id @default(cuid())
  title     String
  rationale String   @default("") // why it helps
  category  String   @default("") // Feature | Efficiency | Data | UX | Cleanup
  impact    String   @default("med") // high | med | low
  effort    String   @default("M") // S | M | L
  status    String   @default("proposed") // proposed | accepted | declined | done
  note      String   @default("") // Jon's note on the decision
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// An active wholesale deal the Dispositions team is pushing to sell.
// Feeds the weekly report's "active deals" page.
model Deal {
  id            String   @id @default(cuid())
  address       String // property address / nickname
  // pipeline: under_contract -> marketing -> buyer_found -> in_escrow -> closed (or dead)
  status        String   @default("under_contract")
  assignedTo    String   @default("") // dispo rep name (Sharyn / Marie)
  buyerName     String   @default("") // set once a buyer is found
  contractPrice Float? // under-contract amount (what we have it locked at)
  askingPrice   Float? // what we're marketing it at
  soldPrice     Float? // final assignment / sale price to the buyer
  assignmentFee Float? // OUR revenue on this deal (profit estimate / fee)

  // ---- pipeline detail mirrored from the Excel deal sheet ----
  dealType      String   @default("") // Novation | Wholesale | JV | Wholesale/Novation ...
  source        String   @default("") // PPL | Irish | Jon ...
  lmAq          String   @default("") // LM/AQ credit, e.g. "Mitch/Jon"

  // ---- key dates (all "YYYY-MM-DD"; blank = unknown) ----
  contractDate       String @default("") // contract signed (us & seller)
  contractExpiration String @default("") // contract expiration (us & seller)
  onMarketSince      String @default("") // first listed on market
  listingSignedDate  String @default("") // listing contract signed
  listingExpiration  String @default("") // listing contract expiration
  soldDate           String @default("") // closed / assigned

  nextSteps String   @default("") // current plan / where the deal stands
  notes     String   @default("")
  active    Boolean  @default(true) // false = archived, hidden from board
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Single-row app configuration.
model Settings {
  id                  Int     @id @default(1)
  googleChatWebhook   String  @default("")
  alertEmailRecipients String @default("") // comma-separated
  emailFromAddress    String  @default("")
  workdayCutoff       String  @default("18:00") // HH:mm local
  weekStart           String  @default("monday")
  orgTimezone         String  @default("America/New_York")
  annualRevenueGoal   Float   @default(0) // for "Goal Remaining by Dec 31" on the report
  weeklyEmailRecipients String @default("") // comma-separated; Monday team-KPI email

  // ---- Monday Meeting deck ----
  homeownersGoal     Int    @default(24) // "Help N homeowners in need" annual mission
  revenueStretchGoal Float  @default(0) // stretch revenue target
  goalReward         String @default("") // incentive copy for hitting the goal
  stretchReward      String @default("") // incentive copy for the stretch goal
  mtgAnnouncements   String @default("") // editorial slide: Team Announcements (newline list)
  mtgComingSoon      String @default("") // editorial slide: Change / Coming Soon
  mtgTalkingPoints   String @default("") // leadership deck: Talking Points (newline list)
  leadAgenda         String @default("") // leadership deck: Agenda (newline list)
  leadActionItems    String @default("") // leadership deck: Decisions / action items
  teamMeetLink       String @default("") // Google Meet link for the Monday all-call
  leadershipMeetLink String @default("") // Google Meet link for the leadership meeting

  // ---- Marketing research ----
  marketingMarkets  String @default("") // markets we're in (newline list)
  marketingResearch String @default("") // freeform research notes
  outreachTemplates String @default("") // copy-paste DM/email openers + leverage

  // ---- Ethan shift-aware KPI reminder ----
  ethanShiftIcsUrl   String @default("") // secret iCal URL of the AQ Shift calendar
  ethanReminderEmail String @default("") // where the EOD reminder goes
  ethanRemindedOn    String @default("") // "YYYY-MM-DD" we last reminded — dedupes same-day sends

  // ---- Time-off Google Calendar (auto-provisioned, service-account owned) ----
  timeoffCalendarId  String @default("") // id of the SA-owned "Time Off" calendar
}

// A Fathom recording link for a past meeting (we store the link, not the video).
model MeetingRecording {
  id           String   @id @default(cuid())
  meeting      String   @default("monday") // monday | leadership
  title        String
  url          String
  meetingDate  String   @default("") // YYYY-MM-DD
  postedToChat Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([meeting, createdAt])
}

// Feedback / notes captured during a Monday Meeting.
model MeetingNote {
  id        String   @id @default(cuid())
  text      String
  author    String   @default("")
  meeting   String   @default("monday") // monday | leadership — which deck's log
  createdAt DateTime @default(now())

  @@index([meeting, createdAt])
}

// Change / Improvement Portal — anyone requests a business change; leadership
// reviews with a two-way comment thread. (Distinct from Ticket, which is for
// bugs in the tracker itself.)
model ChangeRequest {
  id             String          @id @default(cuid())
  submittedBy    String
  submitterEmail String          @default("")
  title          String
  body           String          @default("")
  category       String          @default("other") // script | schedule | process | tool | marketing | other
  status         String          @default("open") // open | reviewing | approved | implemented | declined
  reviewNote     String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  comments       ChangeComment[]

  @@index([status])
}

model ChangeComment {
  id           String        @id @default(cuid())
  request      ChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId    String
  author       String
  body         String
  byLeadership Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([requestId])
}

// AI Champion — team submits AI/automation processes they built; leadership
// reviews and rewards the proven ones with a bonus.
model AiSubmission {
  id             String   @id @default(cuid())
  submittedBy    String
  submitterEmail String   @default("")
  title          String
  description    String   @default("")
  tool           String   @default("") // Claude | GHL | Zapier | …
  hoursSaved     Float? // est hours saved per week
  proofUrl       String   @default("")
  status         String   @default("submitted") // submitted | piloting | proven | declined
  rewardAmount   Float? // bonus paid when proven
  reviewNote     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

// EOS Rock — a quarterly priority (the "big rocks"). Company-wide or owned by
// one person. 3–7 per quarter is the EOS discipline. Status is binary in EOS
// (on-track / off-track) until done; progress % is a soft aid.
model Rock {
  id         String   @id @default(cuid())
  title      String
  owner      String   @default("") // accountable person's display name ("" = company rock)
  isCompany  Boolean  @default(false) // company-level rock vs individual
  quarter    String   @default("") // "2026-Q2"
  dueDate    String   @default("") // YYYY-MM-DD (usually end of quarter)
  status     String   @default("on_track") // on_track | off_track | done
  progress   Int      @default(0) // 0-100 (soft aid; EOS status is the real signal)
  milestones String   @default("") // newline list of sub-steps / milestones
  notes      String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([quarter])
}

// Marketing — buyers / developers / flippers directory + markets + research.
// Distinguishes Luxury/Developers from Distressed/Flippers. Manager-curated.
model MarketContact {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("distressed") // luxury | distressed
  type        String   @default("") // developer | custom | remodeler | flipper | cash_buyer | investor | agent | other
  region      String   @default("") // SD | OC | LA | other
  market      String   @default("") // city / area they buy in
  status      String   @default("") // freeform: Priority | To Vet | Contacted | Buy Box | Dead …
  email       String   @default("")
  phone       String   @default("")
  website     String   @default("")
  buyBox      String   @default("") // price range / criteria / what they want
  buyBoxAreas String   @default("") // target neighborhoods (matched by the area search)
  lat         Float? // map pin
  lng         Float?
  contact     String   @default("") // legacy combined contact
  // Dispo outreach tracking (separate from the CRM):
  igHandle      String @default("") // Instagram handle
  bestContact   String @default("") // best way / sequence to reach them
  lastContacted String @default("") // YYYY-MM-DD of last touch
  nextFollowUp  String @default("") // YYYY-MM-DD next touch due (drives the Due list)
  outreachLog   String @default("") // running notes / touch log
  notes       String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// Target market (Markets & Buyers) — a county/metro we hunt in, with its heat
// tier, top zips & neighborhoods, and the developers who buy there.
model TargetMarket {
  id            String   @id @default(cuid())
  name          String
  region        String   @default("") // OC | SD | LA | TN | HI | other
  tier          String   @default("") // S | 1 | 2 | 3
  score         Int      @default(0) // heat score (sold $2M+, built 2021+)
  summary       String   @default("")
  neighborhoods String   @default("") // zips + neighborhoods (newline list)
  developers    String   @default("") // top builders + buy box (newline list)
  lat           Float?
  lng           Float?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Roadmap / backlog — the running list of what's still to build or do. Owner-
// curated; the team can see where the war room is headed.
model RoadmapItem {
  id        String   @id @default(cuid())
  title     String
  detail    String   @default("")
  category  String   @default("Other") // Hub | Marketing | Process | Automation | Training | Analytics | Other
  status    String   @default("todo") // todo | doing | done
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Software & logins directory (native). Lists every tool the team uses and
// WHERE its password lives (in the team password manager) — NEVER the password
// itself (there is deliberately no password field). The team reads it to find
// logins; the owner curates it. Cost/renewal fields are owner-only in the UI.
model Software {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("Other") // CRM | Dialer | Marketing | Data | Finance | Comms | Productivity | Other
  url          String   @default("") // login URL
  loginEmail   String   @default("") // username / email to log in (NOT the password)
  vaultRef     String   @default("") // where the password lives, e.g. "Bitwarden › Acquisitions"
  vaultUrl     String   @default("") // optional direct link to the vault item
  mfa          String   @default("") // "" | on | off
  owner        String   @default("") // who owns / admins the account
  accessList   String   @default("") // who has access (newline / comma list)
  plan         String   @default("") // plan tier
  monthlyCost  String   @default("") // owner-only in the UI
  billingCycle String   @default("") // monthly | annual
  renewalDate  String   @default("") // YYYY-MM-DD (owner-only)
  notes        String   @default("")
  // Encrypted password (AES-256-GCM, base64 iv+tag+ciphertext). Decryptable only
  // server-side with VAULT_KEY (a Vercel secret, never in the DB). "" = none.
  secret       String   @default("")
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

// Audit trail: who revealed which software password, and when. Owner-visible.
model SecretAccess {
  id           String   @id @default(cuid())
  softwareId   String
  softwareName String   @default("")
  viewedBy     String   @default("")
  viewedAt     DateTime @default(now())

  @@index([viewedAt])
}

// EOS Accountability Chart seat — one box in the org structure. "Right person,
// right seat." Each seat lists its 5 key roles and who sits in it, plus the
// People-Analyzer GWC read (Gets it / Wants it / Capacity). OWNER-ONLY (private).
model Seat {
  id          String   @id @default(cuid())
  title       String // the seat / function, e.g. "Acquisitions", "Integrator"
  holder      String   @default("") // person in the seat
  roles       String   @default("") // the ~5 key roles (newline list)
  parentId    String? // reports-to seat (self-relation = the chart hierarchy)
  sortOrder   Int      @default(0)
  gwcGet      String   @default("") // "" | yes | no
  gwcWant     String   @default("")
  gwcCapacity String   @default("")
  gwcNote     String   @default("") // values fit / notes
  // Assessment results (Predictive Index, IQ, EI) — owner-only reference for fit.
  piProfile   String   @default("") // PI reference profile, e.g. "Strategist"
  piTagline   String   @default("") // PI one-line descriptor
  piSummary   String   @default("") // key behavioral traits (short)
  iq          String   @default("") // IQ score
  ei          String   @default("") // EI quadrant scores
  assessedOn  String   @default("") // when the PI was taken
  roleFit     String   @default("") // how well the role aligns with the results
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
}

// EOS Vision/Traction Organizer (V/TO) — the single-page company vision. One
// row (id=1). Owner-editable (Jon); the whole team reads it. Quarterly Rocks and
// the Issues List (the "Traction" half) live in their own modules.
model Vto {
  id                 Int      @id @default(1)
  coreValues         String   @default("") // newline list
  purpose            String   @default("") // Core Focus — Purpose / Cause / Passion
  niche              String   @default("") // Core Focus — Niche
  tenYearTarget      String   @default("") // the 10-year BHAG
  targetMarket       String   @default("") // marketing strategy — "The List" / ideal client
  uniques            String   @default("") // the 3 Uniques (newline)
  provenProcess      String   @default("") // our proven process name / steps
  guarantee          String   @default("") // the guarantee
  threeYrDate        String   @default("") // e.g. "Dec 31, 2029"
  threeYrRevenue     String   @default("")
  threeYrProfit      String   @default("")
  threeYrMeasurables String   @default("") // newline
  threeYrPicture     String   @default("") // newline bullets — what it looks like
  oneYrDate          String   @default("")
  oneYrRevenue       String   @default("")
  oneYrProfit        String   @default("")
  oneYrMeasurables   String   @default("") // newline
  oneYrGoals         String   @default("") // newline — the 3-7 goals for the year
  updatedAt          DateTime @updatedAt
}

// EOS Issue — anything getting in the way (obstacle, idea, concern). The team
// raises issues; in the Level 10 meeting you prioritize the top 3 and run IDS
// (Identify, Discuss, Solve). Solving one often spawns a To-Do.
model Issue {
  id        String   @id @default(cuid())
  title     String
  detail    String   @default("")
  raisedBy  String   @default("")
  owner     String   @default("") // who owns getting it solved
  priority  Int      @default(0) // manual rank; higher = solve first (top 3)
  scope     String   @default("leadership") // leadership | team — which IDS list
  status    String   @default("open") // open | solved | dropped
  solveNote String   @default("") // the decision when it was solved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// EOS To-Do — a 7-day action item, often the output of solving an Issue. Binary
// done/not-done; reviewed every Level 10 meeting (target 90% completion).
model ToDo {
  id        String   @id @default(cuid())
  text      String
  owner     String   @default("")
  dueDate   String   @default("") // YYYY-MM-DD (EOS ~7 days out)
  done      Boolean  @default(false)
  fromIssue String? // Issue.id this came from (null = standalone)
  createdAt DateTime @default(now())

  @@index([done])
}

// Coaching tips for the Monday Meeting. The deck auto-picks the one matching the
// team's weakest KPI that week; otherwise rotates the general (untagged) ones.
model TrainingTip {
  id        String   @id @default(cuid())
  text      String
  kpiKey    String   @default("") // target KPI key ('' = general)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([kpiKey])
}

// Time off / day-off requests — the team inputs holidays & PTO on the shared
// Schedule calendar. (Future: push approved ones to the user's Google Calendar.)
model TimeOff {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("pto") // pto | holiday | sick | unpaid
  startDate String // YYYY-MM-DD
  endDate   String // YYYY-MM-DD (inclusive)
  note      String   @default("")
  status    String   @default("requested") // requested | approved | denied
  gcalEventId String @default("") // Google Calendar event id once synced (approval)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([startDate])
}

// Time-card punches — clock in/out + break/lunch. Current presence and worked
// time are derived from each user's punches for the day.
model Punch {
  id     String   @id @default(cuid())
  userId String
  date   String // YYYY-MM-DD (org tz) for grouping a shift
  kind   String // in | out | break_start | break_end | lunch_start | lunch_end
  at     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
